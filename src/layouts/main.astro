---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

const { content, title } = Astro.props;
const pageTitle = title ?? content?.title ?? 'Astro Portfolio';
const pathname = Astro.url.pathname;

const isHome = pathname === '/';
const isBlog = pathname === '/blog' || pathname.startsWith('/blog/');
const isPizzas = pathname === '/pizzas' || pathname.startsWith('/pizzas/');

const navLinkClass = (isActive: boolean) =>
	`hover:underline ${isActive ? 'font-semibold underline' : ''}`;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{pageTitle}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Aldrich&family=Press+Start+2P&family=Rubik:ital,wght@0,300..900;1,300..900&family=Share+Tech&family=Sixtyfour&display=swap" rel="stylesheet">
	</head>
	<body class="flex min-h-screen flex-col">
		<ClientRouter />
		<header>
			<nav class="site-nav">
				<a href="/" class="text-2xl font-bold" aria-current={isHome ? 'page' : undefined}>Joe Geringer</a>
				<ul class="flex space-x-6">
					<li>
						<a href="/resume" class={navLinkClass(pathname === '/resume')} aria-current={pathname === '/resume' ? 'page' : undefined}>Resume</a>
					</li>
					<li>
						<a href="/blog" class={navLinkClass(isBlog)} aria-current={isBlog ? 'page' : undefined}>Blog</a>
					</li>
					<li>
						<a href="/pizzas" class={navLinkClass(isPizzas)} aria-current={isPizzas ? 'page' : undefined}>Pizzas</a>
					</li>
				</ul>
			</nav>
		</header>
		<slot />
		<footer class="container mx-auto p-8 text-center text-sm text-gray-500">			
			<ol class="flex gap-8 justify-center">
				<li class="inline-flex items-center">
					<a href="https://codepen.io/jgeringer" target="_blank">
						<svg aria-hidden="true" focusable="false" data-prefix="fab" data-icon="codepen" class="w-8" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path fill="currentColor" d="M502.285 159.704l-234-156c-7.987-4.915-16.511-4.96-24.571 0l-234 156C3.714 163.703 0 170.847 0 177.989v155.999c0 7.143 3.714 14.286 9.715 18.286l234 156.022c7.987 4.915 16.511 4.96 24.571 0l234-156.022c6-3.999 9.715-11.143 9.715-18.286V177.989c-.001-7.142-3.715-14.286-9.716-18.285zM278 63.131l172.286 114.858-76.857 51.429L278 165.703V63.131zm-44 0v102.572l-95.429 63.715-76.857-51.429L234 63.131zM44 219.132l55.143 36.857L44 292.846v-73.714zm190 229.715L61.714 333.989l76.857-51.429L234 346.275v102.572zm22-140.858l-77.715-52 77.715-52 77.715 52-77.715 52zm22 140.858V346.275l95.429-63.715 76.857 51.429L278 448.847zm190-156.001l-55.143-36.857L468 219.132v73.714z"></path></svg>	
					</a>
				</li>
				<li class="inline-flex items-center gap-4">
					<a href="https://github.com/jgeringer" target="_blank">
						<svg aria-hidden="true" focusable="false" data-prefix="fab" data-icon="github" class="w-8" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 496 512"><path fill="currentColor" d="M165.9 397.4c0 2-2.3 3.6-5.2 3.6-3.3.3-5.6-1.3-5.6-3.6 0-2 2.3-3.6 5.2-3.6 3-.3 5.6 1.3 5.6 3.6zm-31.1-4.5c-.7 2 1.3 4.3 4.3 4.9 2.6 1 5.6 0 6.2-2s-1.3-4.3-4.3-5.2c-2.6-.7-5.5.3-6.2 2.3zm44.2-1.7c-2.9.7-4.9 2.6-4.6 4.9.3 2 2.9 3.3 5.9 2.6 2.9-.7 4.9-2.6 4.6-4.6-.3-1.9-3-3.2-5.9-2.9zM244.8 8C106.1 8 0 113.3 0 252c0 110.9 69.8 205.8 169.5 239.2 12.8 2.3 17.3-5.6 17.3-12.1 0-6.2-.3-40.4-.3-61.4 0 0-70 15-84.7-29.8 0 0-11.4-29.1-27.8-36.6 0 0-22.9-15.7 1.6-15.4 0 0 24.9 2 38.6 25.8 21.9 38.6 58.6 27.5 72.9 20.9 2.3-16 8.8-27.1 16-33.7-55.9-6.2-112.3-14.3-112.3-110.5 0-27.5 7.6-41.3 23.6-58.9-2.6-6.5-11.1-33.3 2.6-67.9 20.9-6.5 69 27 69 27 20-5.6 41.5-8.5 62.8-8.5s42.8 2.9 62.8 8.5c0 0 48.1-33.6 69-27 13.7 34.7 5.2 61.4 2.6 67.9 16 17.7 25.8 31.5 25.8 58.9 0 96.5-58.9 104.2-114.8 110.5 9.2 7.9 17 22.9 17 46.4 0 33.7-.3 75.4-.3 83.6 0 6.5 4.6 14.4 17.3 12.1C428.2 457.8 496 362.9 496 252 496 113.3 383.5 8 244.8 8zM97.2 352.9c-1.3 1-1 3.3.7 5.2 1.6 1.6 3.9 2.3 5.2 1 1.3-1 1-3.3-.7-5.2-1.6-1.6-3.9-2.3-5.2-1zm-10.8-8.1c-.7 1.3.3 2.9 2.3 3.9 1.6 1 3.6.7 4.3-.7.7-1.3-.3-2.9-2.3-3.9-2-.6-3.6-.3-4.3.7zm32.4 35.6c-1.6 1.3-1 4.3 1.3 6.2 2.3 2.3 5.2 2.6 6.5 1 1.3-1.3.7-4.3-1.3-6.2-2.2-2.3-5.2-2.6-6.5-1zm-11.4-14.7c-1.6 1-1.6 3.6 0 5.9 1.6 2.3 4.3 3.3 5.6 2.3 1.6-1.3 1.6-3.9 0-6.2-1.4-2.3-4-3.3-5.6-2z"></path></svg>
					</a>
				</li>
				<li class="inline-flex items-center gap-4">
					<a href="https://www.linkedin.com/in/joe-geringer/" target="_blank">
						<svg aria-hidden="true" focusable="false" data-prefix="fab" data-icon="linkedin-in" class="w-8" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><path fill="currentColor" d="M100.28 448H7.4V148.9h92.88zM53.79 108.1C24.09 108.1 0 83.5 0 53.8a53.79 53.79 0 0 1 107.58 0c0 29.7-24.1 54.3-53.79 54.3zM447.9 448h-92.68V302.4c0-34.7-.7-79.2-48.29-79.2-48.29 0-55.69 37.7-55.69 76.7V448h-92.78V148.9h89.08v40.8h1.3c12.4-23.5 42.69-48.3 87.88-48.3 94 0 111.28 61.9 111.28 142.3V448z"></path></svg>	
					</a>
				</li>
				<li class="inline-flex items-center gap-4">
					<a href="/uses/">
						<svg aria-hidden="true" focusable="false" data-prefix="fas" data-icon="tools" class="w-8" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path fill="currentColor" d="M501.1 395.7L384 278.6c-23.1-23.1-57.6-27.6-85.4-13.9L192 158.1V96L64 0 0 64l96 128h62.1l106.6 106.6c-13.6 27.8-9.2 62.3 13.9 85.4l117.1 117.1c14.6 14.6 38.2 14.6 52.7 0l52.7-52.7c14.5-14.6 14.5-38.2 0-52.7zM331.7 225c28.3 0 54.9 11 74.9 31l19.4 19.4c15.8-6.9 30.8-16.5 43.8-29.5 37.1-37.1 49.7-89.3 37.9-136.7-2.2-9-13.5-12.1-20.1-5.5l-74.4 74.4-67.9-11.3L334 98.9l74.4-74.4c6.6-6.6 3.4-17.9-5.7-20.2-47.4-11.7-99.6.9-136.6 37.9-28.5 28.5-41.9 66.1-41.2 103.6l82.1 82.1c8.1-1.9 16.5-2.9 24.7-2.9zm-103.9 82l-56.7-56.7L18.7 402.8c-25 25-25 65.5 0 90.5s65.5 25 90.5 0l123.6-123.6c-7.6-19.9-9.9-41.6-5-62.7zM64 472c-13.2 0-24-10.8-24-24 0-13.3 10.7-24 24-24s24 10.7 24 24c0 13.2-10.7 24-24 24z"></path>
						</svg>
						</a>
						</li>
					</ol>
			
		</footer>
	</body>
</html>

<style>
	.site-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 72rem;
		margin: 1rem auto 0;
		padding: 0.75rem;
		background-color: rgb(255 255 255 / 0.3);
		backdrop-filter: blur(8px);
		border-radius: 0.75rem;
		background: linear-gradient(135deg, #dcdcdc 0%, #c0c0c0 25%, #a9a9a9 75%, #dcdcdc 100%);
		width: 420px;
		flex-direction: column;

		/* font-family: "Press Start 2P", system-ui; */
		font-weight: 400;
		font-style: normal;
		text-transform: uppercase;


	  font-family: "Aldrich", sans-serif;


      text-shadow: 0 1px #ffffff;
	}

	body {
		font-family: "Rubik", sans-serif;
		font-optical-sizing: auto;
		font-weight: 400;
		font-style: normal;

		h1, h2, h3, h4, h5, h6 {
			font-family: "Press Start 2P", system-ui;
			font-weight: 400;
			font-style: normal;
		}
	}


	


	@media (max-width: 768px) {
		.site-nav {
			width: calc(100% - 1rem);
		}
	}
</style>

